{
  "name": "felipeguedesfinanc",
  "version": "1.0.0",
  "private": true,
  "description": "Relatorio de gastos a partir da API do Pluggy",
  "type": "module",
  "scripts": {
    "report": "tsx src/index.ts",
    "connect": "tsx src/connect.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate": "tsx src/migrate.ts",
    "refresh": "tsx src/refreshJob.ts",
    "dev:server": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run build && npm run test:e2e"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.1",
    "pluggy-sdk": "^0.89.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "firebase-tools": "^15.27.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
